{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyPresignedUrlOutsideVpce",
      "Effect": "Deny",
      "Action": "sagemaker:CreatePresignedDomainUrl",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceVpce": [
            "vpce-0aaa1111bbbb22223",
            "vpce-0ccc3333dddd44445"
          ]
        }
      }
    }
  ]
}
