{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BadAndIpAndVpce",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreatePresignedDomainUrl",
        "sagemaker:DescribeUserProfile"
      ],
      "Resource": "*",
      "Condition": {
        "IpAddress": {
          "aws:SourceIp": "203.0.113.0/24"
        },
        "StringEquals": {
          "aws:SourceVpce": "vpce-0aaa1111bbbb22223"
        }
      }
    }
  ]
}
